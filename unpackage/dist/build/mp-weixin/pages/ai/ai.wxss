.bg{position:fixed;top:0;left:0;width:100vw;height:100vh;overflow:hidden;z-index:-1}.bgImg{position:absolute;top:0;left:0;width:160%;height:70%;border-radius:0 0 100%;background:linear-gradient(110.06deg,#fefdf0 1.6%,#c5dffe 72.87%,#e8d4ff 92.97%);transform-origin:top left;transform:scaleY(.5)}.AITitle{display:flex;justify-content:space-between;align-items:center;padding:20px;position:relative;z-index:1}.left-section,.right-section,.center-section{width:33.33%;display:flex;justify-content:center;align-items:center}.left-icon,.center-icon{max-height:60rpx;max-width:100%}.right-section image{max-height:60rpx;max-width:100%}.left-section{transform:translate(-80rpx)}.right-section{transform:translate(80rpx)}.imgRobotBox{display:flex;align-items:center;justify-content:space-between;position:absolute;top:10%;left:-20%;width:100%;height:40vh;z-index:1}.text{color:#000;font-size:50rpx;position:absolute;left:50%;transform:translate(-50%);opacity:1;transition:opacity .3s ease}.fade{opacity:0}.robot-img{max-height:100rpx;max-width:100rpx;margin-right:20rpx;scale:5;position:absolute;right:0rpx;transform:scaleX(-1);transition:transform .3s ease}.robot-img:active{transform:scaleX(-1.1) scaleY(1.1)}.chattingBox{position:absolute;top:calc(10% + 40vh);left:0;width:100%;padding:20rpx;box-sizing:border-box}.guessYourAsking{display:flex;flex-direction:column;align-items:flex-start;background-color:#fff;border-radius:10rpx;padding:20rpx;margin:20rpx;box-shadow:0 4px 8px rgba(0,0,0,.2);scale:.9}.guess-title{display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:10rpx}.guess-title-left,.guess-title-right{display:flex;align-items:center}.guessYourAskingIcon1,.guessYourAskingIcon2{width:30rpx;height:30rpx;margin:0 5rpx}.guess-question{display:flex;align-items:center;margin-bottom:10rpx}.question-circle{width:10rpx;height:10rpx;background-color:#007aff;border-radius:50%;margin-right:10rpx}.Chatting{height:250rpx;overflow-y:auto;border:none;padding:5rpx;margin-bottom:0rpx}.chat-item{display:flex;justify-content:flex-start;margin-bottom:10rpx}.question-container{display:flex;justify-content:flex-end;width:100%}.answer-container{display:flex;justify-content:flex-start;width:100%}.chat-bubble{max-width:85%;padding:15rpx 20rpx;border-radius:10rpx;background-color:#e8d4ff;font-size:28rpx}.question-bubble,.answer-bubble{background-color:#e8d4ff}.Sending{display:flex;flex-direction:column;box-shadow:0 -4px 8px rgba(0,0,0,.2);position:relative}.input-container{display:flex;margin-bottom:10rpx;box-shadow:0 0 5px rgba(0,0,0,.5);border-radius:50px;background:#eaeaea;padding:5rpx 15rpx;transform:translateY(1vh) scaleX(.8);z-index:11}.input-70{flex:0 0 70%;padding:10rpx;border:none;background:transparent;font-size:24rpx}.image-30{flex:0 0 30%;width:40rpx;height:40rpx;margin-left:10rpx;cursor:pointer;display:flex;justify-content:center;transform:translate(20vw) scale(1.5);align-items:center}.Sending input::-webkit-input-placeholder{color:#999}.Sending input::placeholder{color:#999}.upload-options{display:flex;justify-content:space-around}.upload-item{display:flex;flex-direction:column;align-items:center}.upload-image{width:55rpx;height:55rpx;transform:scale(1.1);text-align:center;margin-bottom:5rpx}.rabbit-image{position:absolute;top:-10vh;left:-10vw;width:40vw;height:20vh;z-index:1;transform:scaleX(-1)}
