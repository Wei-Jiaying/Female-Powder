
	/* 页面全局样式 */
.health-page.data-v-04910d43 {
		background-color: #fef4ff;
		min-height: 100vh;
		padding: 20rpx;
		box-sizing: border-box;
}

	/* 页面标题 */
.page-header.data-v-04910d43 {
		padding: 25rpx 0;
		margin-bottom: 30rpx;
}
.header-title.data-v-04910d43 {
		font-size: 34rpx;
		font-weight: 700;
		color: #333;
}

	/* 模式选择器 */
.mode-selector.data-v-04910d43 {
		display: flex;
		justify-content: space-between;
		background-color: #fff;
		border-radius: 24rpx;
		padding: 25rpx;
		margin-bottom: 30rpx;
		box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.mode-item.data-v-04910d43 {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 30%;
		cursor: pointer;
		transition: all 0.2s ease;
}

	/* 模式图标（含emoji） */
.mode-icon.data-v-04910d43 {
		width: 80rpx;
		height: 80rpx;
		border-radius: 20rpx;
		margin-bottom: 15rpx;
		transition: transform 0.2s ease;
		display: flex;
		justify-content: center;
		align-items: center;
}

	/* emoji样式优化 */
.emoji.data-v-04910d43 {
		font-size: 44rpx;
		/* 适中大小，确保清晰可见 */
		line-height: 1;
		color: #fff;
		/* 白色emoji与彩色背景形成对比 */
		text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
		/* 轻微阴影增强立体感 */
}
.mode-name.data-v-04910d43 {
		font-size: 28rpx;
		font-weight: 600;
		color: #666;
}

	/* 选中模式样式 */
.mode-active .mode-icon.data-v-04910d43 {
		transform: scale(1.1);
		box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}
.mode-active .mode-name.data-v-04910d43 {
		color: #333;
}

	/* 模式内容区 */
.mode-content.data-v-04910d43 {
		background-color: #fff;
		border-radius: 24rpx;
		padding: 30rpx;
		box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
		min-height: 500rpx;
		display: flex;
		flex-direction: column;
}

	/* 默认提示 */
.default-tip.data-v-04910d43 {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 500rpx;
		color: #999;
}
.tip-icon.data-v-04910d43 {
		width: 120rpx;
		height: 120rpx;
		margin-bottom: 20rpx;
		opacity: 0.6;
}
.tip-text.data-v-04910d43 {
		font-size: 26rpx;
		text-align: center;
		max-width: 80%;
}
