/* 基础样式：粉蓝专业主题 */
.expert-consult-page.data-v-fc47d1f9 {
  background-color: #f9fbfd;
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* 顶部导航 */
.page-header.data-v-fc47d1f9 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 90rpx;
  padding: 0 10rpx;
  margin-bottom: 20rpx;
}
.back-btn.data-v-fc47d1f9 {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #e6f4ff;
  display: flex;
  justify-content: center;
  align-items: center;
}
.back-icon.data-v-fc47d1f9 {
  font-size: 30rpx;
  color: #1890ff;
}
.header-title.data-v-fc47d1f9 {
  font-size: 32rpx;
  color: #0f62fe;
  font-weight: 600;
}
.header-placeholder.data-v-fc47d1f9 {
  width: 60rpx;
}

/* 咨询类型筛选栏 */
.consult-tabs.data-v-fc47d1f9 {
  display: flex;
  overflow-x: auto;
  gap: 15rpx;
  margin-bottom: 25rpx;
  padding-bottom: 10rpx;
}
.tab-item.data-v-fc47d1f9 {
  white-space: nowrap;
  padding: 12rpx 25rpx;
  background-color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.08);
  transition: all 0.2s;
}
.tab-item.active.data-v-fc47d1f9 {
  background-color: #1890ff;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.15);
}

/* 快速咨询入口 */
.quick-consult.data-v-fc47d1f9 {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff0f5 0%, #e6f4ff 100%);
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 35rpx;
}
.quick-icon.data-v-fc47d1f9 {
  font-size: 60rpx;
  color: #0f62fe;
  margin-right: 25rpx;
}
.quick-text.data-v-fc47d1f9 {
  flex: 1;
}
.quick-title.data-v-fc47d1f9 {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.quick-desc.data-v-fc47d1f9 {
  font-size: 22rpx;
  color: #666;
}
.quick-btn.data-v-fc47d1f9 {
  width: 160rpx;
  height: 60rpx;
  background-color: #0f62fe;
  color: #fff;
  border-radius: 30rpx;
  text-align: center;
  line-height: 60rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 专家列表区域 */
.expert-list.data-v-fc47d1f9 {
  margin-bottom: 40rpx;
}
.section-title.data-v-fc47d1f9 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}
.title-text.data-v-fc47d1f9 {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.title-count.data-v-fc47d1f9 {
  font-size: 22rpx;
  color: #1890ff;
}

/* 专家卡片 */
.expert-card.data-v-fc47d1f9 {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(24, 144, 255, 0.08);
}
.expert-avatar.data-v-fc47d1f9 {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  object-fit: cover;
  margin-right: 25rpx;
  border: 4rpx solid #e6f4ff;
}
.expert-info.data-v-fc47d1f9 {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.info-top.data-v-fc47d1f9 {
  display: flex;
  align-items: center;
  gap: 15rpx;
}
.expert-name.data-v-fc47d1f9 {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.expert-title.data-v-fc47d1f9 {
  font-size: 22rpx;
  color: #666;
  background-color: #f0f7ff;
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
}
.online-tag.data-v-fc47d1f9 {
  font-size: 20rpx;
  color: #fff;
  background-color: #52c41a;
  padding: 3rpx 10rpx;
  border-radius: 10rpx;
  margin-left: auto;
}
.expert-hospital.data-v-fc47d1f9 {
  font-size: 22rpx;
  color: #666;
}

/* 专家标签 */
.expert-tags.data-v-fc47d1f9 {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.tag.data-v-fc47d1f9 {
  font-size: 20rpx;
  color: #1890ff;
  background-color: #f0f7ff;
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
}

/* 专家元信息 */
.expert-meta.data-v-fc47d1f9 {
  display: flex;
  gap: 25rpx;
  margin-top: 10rpx;
}
.meta-item.data-v-fc47d1f9 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #999;
}
.meta-icon.data-v-fc47d1f9 {
  font-size: 22rpx;
}

/* 咨询按钮 */
.consult-btn.data-v-fc47d1f9 {
  width: 140rpx;
  height: 60rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 30rpx;
  text-align: center;
  line-height: 60rpx;
  font-size: 24rpx;
  margin-left: 15rpx;
  margin-top: 20rpx;
}

/* 常见问题区域 */
.faq-section.data-v-fc47d1f9 {
  margin-bottom: 30rpx;
}
.faq-title.data-v-fc47d1f9 {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 25rpx;
  display: block;
}
.faq-grid.data-v-fc47d1f9 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
}
.faq-item.data-v-fc47d1f9 {
  background-color: #fff;
  border-radius: 15rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.05);
}
.faq-icon.data-v-fc47d1f9 {
  font-size: 24rpx;
  color: #1890ff;
}
.faq-text.data-v-fc47d1f9 {
  font-size: 22rpx;
  color: #333;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 预约弹窗样式 */
.popup-mask.data-v-fc47d1f9 {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 998;
}
.reserve-popup.data-v-fc47d1f9 {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  z-index: 999;
}
.popup-header.data-v-fc47d1f9 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  background-color: #f0f7ff;
}
.popup-title.data-v-fc47d1f9 {
  font-size: 28rpx;
  color: #0f62fe;
  font-weight: 600;
}
.popup-close.data-v-fc47d1f9 {
  font-size: 32rpx;
  color: #666;
}
.popup-content.data-v-fc47d1f9 {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 专家简介 */
.expert-brief.data-v-fc47d1f9 {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.brief-avatar.data-v-fc47d1f9 {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  object-fit: cover;
}
.brief-info.data-v-fc47d1f9 {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.brief-name.data-v-fc47d1f9 {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}
.brief-hospital.data-v-fc47d1f9 {
  font-size: 20rpx;
  color: #666;
}

/* 表单项 */
.form-item.data-v-fc47d1f9 {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.form-label.data-v-fc47d1f9 {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* 咨询类型选择 */
.form-select.data-v-fc47d1f9 {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}
.select-option.data-v-fc47d1f9 {
  padding: 12rpx 25rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666;
}
.select-option.active.data-v-fc47d1f9 {
  background-color: #1890ff;
  color: #fff;
}

/* 时间选择 */
.time-select.data-v-fc47d1f9 {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.time-option.data-v-fc47d1f9 {
  padding: 15rpx;
  background-color: #f5f5f5;
  border-radius: 15rpx;
  font-size: 22rpx;
  color: #666;
}
.time-option.active.data-v-fc47d1f9 {
  background-color: #e6f4ff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

/* 问题输入框 */
.problem-input.data-v-fc47d1f9 {
  min-height: 150rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 15rpx;
  border: none;
  outline: none;
  font-size: 22rpx;
  color: #333;
}

/* 弹窗底部按钮 */
.popup-footer.data-v-fc47d1f9 {
  display: flex;
}
.popup-cancel.data-v-fc47d1f9, .popup-confirm.data-v-fc47d1f9 {
  flex: 1;
  height: 70rpx;
  text-align: center;
  line-height: 70rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.popup-cancel.data-v-fc47d1f9 {
  background-color: #f5f5f5;
  color: #666;
  border-radius: 0 0 0 24rpx;
}
.popup-confirm.data-v-fc47d1f9 {
  background-color: #1890ff;
  color: #fff;
  border-radius: 0 0 24rpx 0;
}

/* 预约成功弹窗 */
.success-popup.data-v-fc47d1f9 {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70%;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 25rpx;
  z-index: 999;
}
.success-icon.data-v-fc47d1f9 {
  font-size: 60rpx;
  color: #52c41a;
}
.success-title.data-v-fc47d1f9 {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}
.success-desc.data-v-fc47d1f9 {
  font-size: 22rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}
.success-btn.data-v-fc47d1f9 {
  width: 180rpx;
  height: 65rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 30rpx;
  text-align: center;
  line-height: 65rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 响应式调整 */
@media (max-width: 320px) {
.expert-name.data-v-fc47d1f9 {
    font-size: 24rpx;
}
.consult-btn.data-v-fc47d1f9 {
    width: 120rpx;
    font-size: 22rpx;
}
.faq-text.data-v-fc47d1f9 {
    font-size: 20rpx;
}
}