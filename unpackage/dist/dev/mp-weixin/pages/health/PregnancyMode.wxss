}

/* 功能按钮网格 */
.function-grid.data-v-79c1c25e {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15rpx;
}
.function-item.data-v-79c1c25e {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.2s;
}
.function-item.data-v-79c1c25e:active {
  background-color: #f0f0f0;
}
.function-icon.data-v-79c1c25e {
  width: 50rpx;
  height: 50rpx;
  background-color: #e6f3ff;
