/* 全局样式 */
.pregnancy-page.data-v-79c1c25e {
  padding: 20rpx;
  background-color: #fef4ff;
  min-height: 100vh;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.background.data-v-79c1c25e {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #fff9e8 0%, #ffeeef 30%, #f8e8ff 100%);
  z-index: -1;
  opacity: 0.5;
}

/* 标题样式 */
.title.data-v-79c1c25e {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
}
.title .icon.data-v-79c1c25e {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background-color: #c5dffe;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  margin-right: 15rpx;
}
.title .title-text.data-v-79c1c25e {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 卡片样式 */
.card.data-v-79c1c25e {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 25rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 顶部容器 */
