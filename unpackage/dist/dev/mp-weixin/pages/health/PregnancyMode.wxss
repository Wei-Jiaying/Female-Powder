/* 开关样式 */
.toggle-switch.data-v-79c1c25e {
  width: 60rpx;
  height: 34rpx;
  background-color: #eee;
  border-radius: 34rpx;
  position: relative;
  cursor: pointer;
}
.toggle-switch .switch-track.data-v-79c1c25e {
  width: 100%;
  height: 100%;
  border-radius: 34rpx;
  background-color: #c5dffe;
  transition: background-color 0.3s;
}
.toggle-switch .switch-thumb.data-v-79c1c25e {
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background-color: #fff;
  top: 2rpx;
  left: 2rpx;
  transition: transform 0.3s;
}
.toggle-switch .switch-on.data-v-79c1c25e {
  background-color: #8ab4f8;
}
.toggle-switch .thumb-on.data-v-79c1c25e {
  transform: translateX(26rpx);
}

